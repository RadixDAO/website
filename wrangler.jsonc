{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Same Cloudflare account as consultation_v2 (shows as "Radix DAO" in the
	// dashboard). Confirm before handover that this account is actually
	// DAO-controlled and not a personal account — see §9 of the requirements
	// brief (domain custody must sit in DAO-controlled accounts).
	"account_id": "cdb0453c60d48cf58f44f34f9eb6bbe2",
	"name": "website",
	"compatibility_date": "2026-08-07",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Custom domain requires a radixdao.org zone in whichever Cloudflare
	// account ends up DAO-controlled.
	// "routes": [
	//   { "pattern": "www.radixdao.org", "custom_domain": true }
	// ],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
