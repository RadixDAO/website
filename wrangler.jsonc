{
	"$schema": "node_modules/wrangler/config-schema.json",
	// DAO-controlled Cloudflare account. One maintainer currently administers
	// it; expanding custody is tracked as an operational follow-up.
	"account_id": "cdb0453c60d48cf58f44f34f9eb6bbe2",
	"name": "website",
	"compatibility_date": "2026-08-11",
	"main": "./worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	// Both hosts terminate at this Worker. Worker code permanently redirects
	// www to the DAO's canonical apex hostname before serving any asset.
	"routes": [
		{ "pattern": "radixdao.org", "custom_domain": true },
		{ "pattern": "www.radixdao.org", "custom_domain": true }
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
