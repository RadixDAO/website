{
	"$schema": "node_modules/wrangler/config-schema.json",
	// DAO-controlled Cloudflare account. One maintainer currently administers
	// it; expanding custody is tracked as an operational follow-up.
	"account_id": "cdb0453c60d48cf58f44f34f9eb6bbe2",
	"name": "website",
	"compatibility_date": "2026-08-11",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// The apex is the canonical Worker domain. www already has proxied DNS and
	// a Cloudflare Redirect Rule that sends it to the apex; claiming www as a
	// Worker custom domain would conflict with that managed DNS record.
	"routes": [{ "pattern": "radixdao.org", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
