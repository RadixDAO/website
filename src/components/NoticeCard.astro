---
interface Props {
  type: string
  title: string
  href: string
  pubDate: Date
  supersededByHref?: string
}

const { type, title, href, pubDate, supersededByHref } = Astro.props

const formatted = pubDate.toISOString().slice(0, 10)
---

<article class="flex flex-col gap-1 border-b border-[var(--color-border)] py-4">
	<div class="flex flex-wrap items-center gap-3 text-xs text-[var(--color-text-muted)]">
		<span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 uppercase tracking-wide">
			{type}
		</span>
		<time datetime={pubDate.toISOString()}>{formatted}</time>
		{supersededByHref && (
			<a href={supersededByHref} class="text-[var(--color-accent)]">Superseded — see correction</a>
		)}
	</div>
	<a href={href} class="text-base font-medium hover:text-[var(--color-accent)]">{title}</a>
</article>
