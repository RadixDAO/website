---
// The first icon in the site. Deliberately drawn in the same line-work as the
// theme toggle and the status caret — 24×24, stroked, currentColor — rather
// than dropped in as Telegram's filled brand mark. A foreign logo sitting in a
// register row would read as an endorsement badge; a paper plane reads as
// "this is a message channel", which is all it needs to say.
interface Props {
  class?: string
}

const { class: className = 'size-[0.875rem]' } = Astro.props
---

<svg
	aria-hidden="true"
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<path d="M21.5 3.5 2.5 10.2l6.1 2.2 2.2 6.1 3-6.1z"></path>
	<path d="m8.6 12.4 12.9-8.9"></path>
</svg>
