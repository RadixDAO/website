---
const links = [
  { label: 'About', href: '/about/' },
  { label: 'People', href: '/people/' },
  { label: 'Notices & Records', href: '/notices/' },
  { label: 'Contact', href: '/contact/' }
]

// §7.6: the record must be independently archivable without scraping.
const feeds = [
  { label: 'RSS', href: '/notices/rss.xml' },
  { label: 'JSON', href: '/notices.json' }
]
---

<footer class="border-t border-[var(--color-rule)]">
	<div class="mx-auto max-w-(--container-shell) px-6 py-10 md:px-8">
		<div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
			<nav aria-label="Footer">
				<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.875rem] text-[var(--color-muted)]">
					{
						links.map((link) => (
							<li>
								<a href={link.href} class="hover:text-[var(--color-ink)]">
									{link.label}
								</a>
							</li>
						))
					}
					{
						feeds.map((feed) => (
							<li>
								<a href={feed.href} class="label hover:text-[var(--color-ink)]">
									{feed.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<a
				href="https://www.radixdlt.com"
				class="text-[0.875rem] text-[var(--color-muted)] hover:text-[var(--color-ink)]"
			>
				radixdlt.com &rarr;
			</a>
		</div>

		<!-- §8.2.3: persistent, on every page, stating the separate legal identity. -->
		<p class="mt-8 max-w-[68ch] text-[0.78125rem] leading-relaxed text-[var(--color-muted)]">
			Radix DAO LLC is a non-profit Decentralized Autonomous Organization LLC registered under
			Marshall Islands law, and a separate legal entity from Radix Publishing Ltd, which operates
			radixdlt.com.
		</p>
	</div>
</footer>
