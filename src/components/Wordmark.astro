---
// §8.2.2 requires a wordmark visually related to the Radix mark but not
// identical, and no shared artwork. Radix's mark is a check. This is a check
// inside brackets — the notation for something entered into a record. Same
// gesture, different container, different colour, drawn from scratch.
interface Props {
  /** Reversed for the deep band, where the ground is always navy. */
  reversed?: boolean
  class?: string
}

const { reversed = false, class: className = '' } = Astro.props

const bracket = reversed ? '#ffffff' : 'var(--color-ink)'
const tick = reversed ? 'var(--color-accent-deep)' : 'var(--color-accent)'
---

<span
	class:list={['inline-flex items-center gap-2.5', className]}
	style={reversed ? 'color: #ffffff' : 'color: var(--color-ink)'}
>
	<svg width="26" height="23" viewBox="0 0 30 26" fill="none" aria-hidden="true" class="shrink-0">
		<path d="M8 3H3v20h5" stroke={bracket} stroke-width="1.9" stroke-linecap="square"></path>
		<path d="M22 3h5v20h-5" stroke={bracket} stroke-width="1.9" stroke-linecap="square"></path>
		<path d="M10.5 13.4l3.9 4.1L20.5 8" stroke={tick} stroke-width="3.3" stroke-linecap="square"
		></path>
	</svg>
	<span class="text-[1.0625rem] leading-none font-bold tracking-[0.13em]">RADIX</span>
	<span class="h-[0.95rem] w-px bg-current opacity-35" aria-hidden="true"></span>
	<span
		class="text-[1.0625rem] leading-none font-bold tracking-[0.13em]"
		style={`color: ${tick}`}>DAO</span
	>
</span>
