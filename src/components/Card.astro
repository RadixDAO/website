---
// Rule 5.3: every card is at most 3 sentences and ends in a link. This component
// only provides room for ~3 short sentences by design — if the slot content
// needs more space than that to read well, the copy is the thing to fix.
interface Props {
  title: string
  href: string
  linkText: string
}

const { title, href, linkText } = Astro.props
---

<div class="flex flex-col gap-3 rounded-lg border border-[var(--color-border)] p-6">
	<h3 class="text-lg font-bold">{title}</h3>
	<p class="text-sm text-[var(--color-text-muted)]">
		<slot />
	</p>
	<a
		href={href}
		class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] hover:underline"
	>
		{linkText} <span aria-hidden="true">&rsaquo;</span>
	</a>
</div>
