---
interface Props {
  phase: string
  headline: string
  linkHref: string
  linkText: string
}

const { phase, headline, linkHref, linkText } = Astro.props
---

<div class="rounded-lg border border-[var(--color-accent)]/40 bg-[var(--color-bg-raised)] p-6 md:p-8">
	<p
		class="text-xs font-semibold tracking-wide text-[var(--color-accent)] uppercase"
	>
		{phase}
	</p>
	<p class="mt-2 text-lg font-bold">{headline}</p>
	<div class="mt-2 max-w-2xl text-sm text-[var(--color-text-muted)] [&_a]:text-[var(--color-accent)] [&_a]:underline">
		<slot />
	</div>
	<a
		href={linkHref}
		class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] hover:underline"
	>
		{linkText} <span aria-hidden="true">&rsaquo;</span>
	</a>
</div>
