---
import Band from '../components/Band.astro'
import PageHeader from '../components/PageHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const mailboxes = ['veto@radix.community', 'rac@radix.community']
---

<BaseLayout title="Contact" description="How to reach a person, file a veto, or raise a concern.">
	<Band>
		<PageHeader question="How do I reach a person?" heading="Reach a person">
			<p class="mt-5 max-w-[52ch] text-[1.0625rem] text-[var(--color-muted)]">
				Two monitored mailboxes, either of which reaches the Accountability Council.
			</p>
		</PageHeader>

		<ul class="mt-8 border-t border-[var(--color-rule)]">
			{
				mailboxes.map((address) => (
					<li class="border-b border-[var(--color-rule)] py-4">
						<a href={`mailto:${address}`} class="data text-[0.9375rem] text-[var(--color-accent)] hover:underline">
							{address}
						</a>
					</li>
				))
			}
		</ul>

		<p class="mt-5 max-w-[58ch] text-[0.9375rem] text-[var(--color-muted)]">
			To reach one person rather than the mailbox, every member of the Transition Council publishes
			a Telegram handle.
		</p>
		<a href="/people/" class="onward mt-3 inline-block text-[0.875rem]">
			Council members and their handles <span aria-hidden="true">&rsaquo;</span>
		</a>

		<div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
			<div>
				<h2 class="text-[1.125rem]">File a veto</h2>
				<p class="mt-2.5 text-[0.9375rem] text-[var(--color-muted)]">
					Email a filing to either address within the 48-hour challenge window. It is published
					to the record exactly as received, with its receipt timestamp, within six hours.
				</p>
				<a href="/notices/type/veto-filing/" class="onward mt-3 inline-block text-[0.875rem]">
					See filings on the record <span aria-hidden="true">&rsaquo;</span>
				</a>
			</div>

			<div>
				<h2 class="text-[1.125rem]">Raise a concern</h2>
				<p class="mt-2.5 text-[0.9375rem] text-[var(--color-muted)]">
					To request a Community Accountability Hearing or raise a dispute, use the same
					addresses. Read the process before you file.
				</p>
				<a
					href="https://github.com/Shadaffy/radix-dao-governance/blob/master/pending/governance/dispute-resolution-and-arbitration-policy.md"
					class="onward mt-3 inline-block text-[0.875rem]"
				>
					How disputes are resolved <span aria-hidden="true">&rsaquo;</span>
				</a>
			</div>
		</div>
	</Band>

	<Band tone="paper" ruled compact>
		<div class="flex gap-4">
			<span
				class="mt-1.5 block h-auto w-[3px] shrink-0 bg-[var(--color-pending)]"
				aria-hidden="true"></span>
			<div>
				<h2 class="label text-[var(--color-pending)]">Known gap</h2>
				<p class="mt-2 max-w-[62ch] text-[0.9375rem] text-[var(--color-muted)]">
					No discussion platform has been designated yet, so there is nowhere to send you for
					open-ended conversation about a proposal in progress. Individual Transition Council
					members are reachable on Telegram, but a personal handle is not a DAO channel and nothing
					said there is on the record. Designating one is a decision for the DAO, not for this site
					— check back once it is named.
				</p>
			</div>
		</div>
	</Band>
</BaseLayout>
