---
import { getCollection } from 'astro:content'
import Band from '../../components/Band.astro'
import NoticeCard from '../../components/NoticeCard.astro'
import { NOTICE_TYPES } from '../../data/notice-types'
import BaseLayout from '../../layouts/BaseLayout.astro'

// Complete, unpaginated archive — nothing ages out (§7.2). Type filtering is
// primarily served by the static /notices/type/[type]/ pages so it works with
// JavaScript off (§7.6); this index just lists everything in one place.
const notices = (await getCollection('notices')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const supersededIds = new Set(
  notices.map((n) => n.data.supersedes).filter(Boolean)
)
---

<BaseLayout
	title="Notices & Records"
	description="The DAO's official record — every notice published, permanently, with a timestamp."
>
	<Band>
		<h1 class="text-3xl font-bold md:text-4xl">Notices & Records</h1>
		<p class="mt-4 max-w-xl text-[var(--color-text-muted)]">
			This is the Official Venue's official record. Every item here is permanent — corrections
			are published as new, linked items, never edited in place.
		</p>
		<div class="mt-4 flex flex-wrap gap-4 text-sm">
			<a href="/notices/rss.xml" class="font-medium text-[var(--color-accent)] hover:underline"
				>RSS feed</a
			>
			<a href="/notices.json" class="font-medium text-[var(--color-accent)] hover:underline"
				>JSON feed</a
			>
		</div>
		<nav aria-label="Filter by type" class="mt-6 flex flex-wrap gap-2 text-xs">
			{
				NOTICE_TYPES.map((t) => (
					<a
						href={`/notices/type/${t.value}/`}
						class="rounded-full border border-[var(--color-border)] px-3 py-1 hover:border-[var(--color-accent)]"
					>
						{t.label}
					</a>
				))
			}
		</nav>
	</Band>

	<Band raised>
		{
			notices.length > 0 ? (
				<div>
					{notices.map((notice) => (
						<NoticeCard
							type={notice.data.type}
							title={notice.data.title}
							href={`/notices/${notice.id}/`}
							pubDate={notice.data.pubDate}
							supersededByHref={
								supersededIds.has(notice.id)
									? notices.find((n) => n.data.supersedes === notice.id)?.id &&
										`/notices/${notices.find((n) => n.data.supersedes === notice.id)?.id}/`
									: undefined
							}
						/>
					))}
				</div>
			) : (
				<p class="text-sm text-[var(--color-text-muted)]">
					Nothing has been published to the record yet. Nothing is operative until the
					framework's ratification vote (GP-PRE-1) passes — see{' '}
					<a href="/govern/" class="text-[var(--color-accent)] hover:underline">
						Govern
					</a>{' '}
					for where things stand.
				</p>
			)
		}
	</Band>
</BaseLayout>
