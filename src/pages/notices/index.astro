---
import { getCollection } from 'astro:content'
import Band from '../../components/Band.astro'
import NoticeRegister from '../../components/NoticeRegister.astro'
import PageHeader from '../../components/PageHeader.astro'
import { NOTICE_TYPES } from '../../data/notice-types'
import BaseLayout from '../../layouts/BaseLayout.astro'

// Complete, unpaginated archive — nothing ages out (§7.2). Type filtering is
// served by the static /notices/type/[type]/ pages so it works with JavaScript
// off (§7.6); this index lists everything in one place.
const notices = (await getCollection('notices')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const correctionFor = new Map(
  notices
    .filter((n) => n.data.supersedes)
    .map((n) => [n.data.supersedes as string, n.id])
)

const items = notices.map((n) => {
  const correctionId = correctionFor.get(n.id)
  return {
    id: n.id,
    type: n.data.type,
    title: n.data.title,
    pubDate: n.data.pubDate,
    noticeDate: n.data.noticeDate,
    supersededByHref: correctionId ? `/notices/${correctionId}/` : undefined
  }
})

const countsByType = new Map<string, number>()
for (const n of notices) {
  countsByType.set(n.data.type, (countsByType.get(n.data.type) ?? 0) + 1)
}
---

<BaseLayout
	title="Notices & Records"
	description="The DAO's official record — every notice published, permanently, with a timestamp."
>
	<Band compact>
		<PageHeader question="What has officially happened?" heading="Notices & Records">
			<p class="mt-5 max-w-[56ch] text-[1.0625rem] text-[var(--color-muted)]">
				The complete record. Nothing is edited after publication and nothing ages out — a
				correction is published as a new item that links back to the one it supersedes.
			</p>
		</PageHeader>

		<nav aria-label="Filter by type" class="mt-8 flex flex-wrap gap-2">
			<span
				class="label rounded-[2px] border border-[var(--color-accent)] px-2.5 py-1 text-[0.71875rem] text-[var(--color-accent)]"
			>
				All · {notices.length}
			</span>
			{
				NOTICE_TYPES.map((t) => (
					<a
						href={`/notices/type/${t.value}/`}
						class="label rounded-[2px] border border-[var(--color-rule-strong)] px-2.5 py-1 text-[0.71875rem] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
					>
						{t.label} · {countsByType.get(t.value) ?? 0}
					</a>
				))
			}
		</nav>
	</Band>

	<Band tone="paper" ruled>
		<NoticeRegister
			items={items}
			emptyNote="Nothing has been published to the record yet. Nothing is operative until the framework's ratification vote passes."
		/>

		<p class="mt-8 max-w-[64ch] text-[0.875rem] text-[var(--color-muted)]">
			Readable without JavaScript, without a login and without a cookie banner. The full record is
			available as <a href="/notices/rss.xml" class="onward">RSS</a> and
			<a href="/notices.json" class="onward">JSON</a> so it can be archived independently.
		</p>
	</Band>
</BaseLayout>
