---
import { getCollection, getEntry, render } from 'astro:content'
import Band from '../../components/Band.astro'
import { noticeTypeLabel } from '../../data/notice-types'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const notices = await getCollection('notices')
  return notices.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const allNotices = await getCollection('notices')
const supersededBy = allNotices.find((n) => n.data.supersedes === entry.id)
const supersedes = entry.data.supersedes
  ? await getEntry('notices', entry.data.supersedes)
  : undefined

const published = entry.data.pubDate.toISOString().replace('.000', '')
---

<BaseLayout
	title={entry.data.title}
	description={`${noticeTypeLabel(entry.data.type)} published ${entry.data.pubDate.toISOString().slice(0, 10)}.`}
>
	<Band compact>
		<a
			href="/notices/"
			class="mb-6 inline-block text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]"
		>
			&larr; All notices
		</a>

		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<span
				class="label rounded-[2px] border border-[var(--color-rule-strong)] px-2 py-[3px] text-[0.71875rem]"
			>
				{noticeTypeLabel(entry.data.type)}
			</span>
			<time datetime={entry.data.pubDate.toISOString()} class="data text-[0.78125rem] text-[var(--color-muted)]">
				Published {published}
			</time>
		</div>

		<h1 class="mt-4 max-w-[24ch] text-[2.125rem] md:text-[2.5rem]">{entry.data.title}</h1>

		{/* §7.4: a prior-notice date starts a statutory clock, so it is displayed
		    prominently rather than buried in metadata. */}
		{
			entry.data.noticeDate && (
				<div class="mt-7 flex gap-4 border-l-[3px] border-[var(--color-pending)] bg-[var(--color-paper)] py-4 pr-5 pl-5">
					<div>
						<p class="label text-[var(--color-pending)]">Notice date</p>
						<p class="data mt-1.5 text-[1.0625rem] font-medium">
							{entry.data.noticeDate.toISOString().slice(0, 10)}
						</p>
						<p class="mt-1.5 max-w-[52ch] text-[0.875rem] text-[var(--color-muted)]">
							This date starts a countdown before the change described here can take effect.
						</p>
					</div>
				</div>
			)
		}

		{
			supersededBy && (
				<div class="mt-5 border-l-[3px] border-[var(--color-accent)] bg-[var(--color-accent-soft)] py-4 pr-5 pl-5">
					<p class="label text-[var(--color-accent)]">Superseded</p>
					<p class="mt-1.5 max-w-[56ch] text-[0.9375rem]">
						Corrected by{' '}
						<a href={`/notices/${supersededBy.id}/`} class="onward">
							{supersededBy.data.title}
						</a>
						. This item is kept reachable, exactly as originally published.
					</p>
				</div>
			)
		}

		{
			supersedes && (
				<div class="mt-5 border-l-[3px] border-[var(--color-rule-strong)] py-4 pr-5 pl-5">
					<p class="label">Correction</p>
					<p class="mt-1.5 max-w-[56ch] text-[0.9375rem]">
						This corrects{' '}
						<a href={`/notices/${supersedes.id}/`} class="onward">
							{supersedes.data.title}
						</a>
						.
					</p>
				</div>
			)
		}
	</Band>

	<Band tone="paper" ruled compact>
		{
			entry.data.verbatim ? (
				/* §7.3: compliance challenges are published exactly as received. The exhibit
				   frame makes that visible — nothing here has been reformatted. */
				<div class="border border-[var(--color-rule)] bg-[var(--color-ground)]">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-[var(--color-rule)] px-5 py-3">
						<span class="label text-[var(--color-accent)]">
							{noticeTypeLabel(entry.data.type)}
						</span>
						<span class="data text-[0.71875rem] text-[var(--color-muted)]">
							PUBLISHED {published}
						</span>
						<span class="data ml-auto text-[0.71875rem] text-[var(--color-muted)]">
							PUBLISHED VERBATIM — NOT EDITED
						</span>
					</div>
					<div class="verbatim px-5 py-5">{entry.body}</div>
				</div>
			) : (
				<div class="copy text-[1.0625rem]">
					<Content />
				</div>
			)
		}
	</Band>
</BaseLayout>
