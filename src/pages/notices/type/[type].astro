---
import { getCollection } from 'astro:content'
import Band from '../../../components/Band.astro'
import NoticeRegister from '../../../components/NoticeRegister.astro'
import PageHeader from '../../../components/PageHeader.astro'
import { NOTICE_TYPES } from '../../../data/notice-types'
import BaseLayout from '../../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const notices = await getCollection('notices')
  return NOTICE_TYPES.map((t) => ({
    params: { type: t.value },
    props: {
      label: t.label,
      description: t.description,
      items: notices
        .filter((n) => n.data.type === t.value)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .map((n) => ({
          id: n.id,
          type: n.data.type,
          title: n.data.title,
          pubDate: n.data.pubDate,
          noticeDate: n.data.noticeDate,
          verbatim: n.data.verbatim
        }))
    }
  }))
}

const { label, description, items } = Astro.props
---

<BaseLayout title={`${label} — Notices`} description={description}>
	<Band compact>
		<PageHeader
			question="What has officially happened?"
			heading={label}
			backHref="/notices/"
			backText="All notices"
		>
			<p class="mt-5 max-w-[56ch] text-[1.0625rem] text-[var(--color-muted)]">
				{description}
			</p>
		</PageHeader>
	</Band>

	<Band tone="paper" ruled>
		<NoticeRegister items={items} emptyNote="No items of this type have been published yet." />
	</Band>
</BaseLayout>
