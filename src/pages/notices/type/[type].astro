---
import { getCollection } from 'astro:content'
import Band from '../../../components/Band.astro'
import NoticeRegister from '../../../components/NoticeRegister.astro'
import PageHeader from '../../../components/PageHeader.astro'
import { NOTICE_TYPES, noticeTypeLabel } from '../../../data/notice-types'
import BaseLayout from '../../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const notices = await getCollection('notices')
  return NOTICE_TYPES.map((t) => ({
    params: { type: t.value },
    props: {
      items: notices
        .filter((n) => n.data.type === t.value)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .map((n) => ({
          id: n.id,
          type: n.data.type,
          title: n.data.title,
          pubDate: n.data.pubDate,
          noticeDate: n.data.noticeDate
        }))
    }
  }))
}

const { type } = Astro.params
const { items } = Astro.props
const label = noticeTypeLabel(type as string)
---

<BaseLayout
	title={`${label} — Notices`}
	description={`All ${label.toLowerCase()} items in the DAO's official record.`}
>
	<Band compact>
		<PageHeader
			question="What has officially happened?"
			heading={label}
			backHref="/notices/"
			backText="All notices"
		/>
	</Band>

	<Band tone="paper" ruled>
		<NoticeRegister items={items} emptyNote="No items of this type have been published yet." />
	</Band>
</BaseLayout>
