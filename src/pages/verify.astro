---
import Band from '../components/Band.astro'
import identifiers from '../data/identifiers.json'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
	title="Verify"
	description="Every on-chain identifier the DAO uses, with a working link to check it yourself."
>
	<Band>
		<h1 class="text-3xl font-bold md:text-4xl">Check it yourself</h1>
		<p class="mt-4 max-w-xl text-[var(--color-text-muted)]">
			Every governance contract, badge, and treasury account the DAO uses is listed below with a
			link to the Radix Dashboard.
		</p>
	</Band>

	<Band raised>
		<h2 class="text-sm font-semibold tracking-wide text-[var(--color-text-muted)] uppercase">
			Governance
		</h2>
		<div class="mt-4 overflow-x-auto">
			<table class="w-full min-w-[32rem] text-left text-sm">
				<thead>
					<tr class="border-b border-[var(--color-border)] text-[var(--color-text-muted)]">
						<th class="py-2 pr-4 font-medium">Function</th>
						<th class="py-2 pr-4 font-medium">Identifier</th>
						<th class="py-2 font-medium">Verify</th>
					</tr>
				</thead>
				<tbody>
					{
						identifiers.governance.map(
							(row: { function: string; identifier: string; verifyHref: string }) => (
								<tr class="border-b border-[var(--color-border)]">
									<td class="py-3 pr-4">{row.function}</td>
									<td class="py-3 pr-4 font-mono text-xs break-all">{row.identifier}</td>
									<td class="py-3">
										<a href={row.verifyHref} class="text-[var(--color-accent)] hover:underline">
											Dashboard <span aria-hidden="true">&rsaquo;</span>
										</a>
									</td>
								</tr>
							)
						)
					}
				</tbody>
			</table>
		</div>
		<p class="mt-4 max-w-xl text-sm text-[var(--color-text-muted)]">{identifiers.lsuNote}</p>
		<a
			href={identifiers.lsuMethodHref}
			class="text-sm font-medium text-[var(--color-accent)] hover:underline"
			>Read the snapshot method <span aria-hidden="true">&rsaquo;</span></a
		>
	</Band>

	<Band>
		<h2 class="text-sm font-semibold tracking-wide text-[var(--color-text-muted)] uppercase">
			Treasury
		</h2>
		<p class="mt-3 max-w-xl text-sm text-[var(--color-text-muted)]">
			Not yet deployed. Shown here, marked pending, so this table always reflects the DAO's real
			state rather than hiding what doesn't exist yet.
		</p>
		<div class="mt-4 overflow-x-auto">
			<table class="w-full min-w-[24rem] text-left text-sm">
				<thead>
					<tr class="border-b border-[var(--color-border)] text-[var(--color-text-muted)]">
						<th class="py-2 pr-4 font-medium">Function</th>
						<th class="py-2 font-medium">Status</th>
					</tr>
				</thead>
				<tbody>
					{
						identifiers.treasury.map((row: { function: string; status: string; note?: string }) => (
							<tr class="border-b border-[var(--color-border)]">
								<td class="py-3 pr-4">{row.function}</td>
								<td class="py-3 text-[var(--color-text-muted)]">
									Pending{row.note ? ` — ${row.note}` : ''}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<a
			href={identifiers.sourceHref}
			class="mt-4 inline-block text-sm font-medium text-[var(--color-accent)] hover:underline"
			>Source policy <span aria-hidden="true">&rsaquo;</span></a
		>
	</Band>
</BaseLayout>
