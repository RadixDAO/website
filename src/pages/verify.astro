---
import Band from '../components/Band.astro'
import DocumentRegister from '../components/DocumentRegister.astro'
import DocumentVerifier from '../components/DocumentVerifier.astro'
import PageHeader from '../components/PageHeader.astro'
import identifiers from '../data/identifiers.json'
import { inForce } from '../data/governance'
import BaseLayout from '../layouts/BaseLayout.astro'

// §6.7: the treasury rows show even though nothing is deployed, marked pending.
// Hiding them would misrepresent the state of the DAO, so "pending" is a state
// the table is designed for rather than a gap it papers over.
interface GovernanceRow {
  function: string
  identifier: string
  verifyHref: string
}

interface TreasuryRow {
  function: string
  status: string
  note?: string
}
---

<BaseLayout
	title="Verify"
	description="Every on-chain identifier the DAO uses, with a working link to check it yourself."
>
	<Band compact>
		<PageHeader question="Can I check any of this myself?" heading="Check it yourself">
			<p class="mt-5 max-w-[54ch] text-[1.0625rem] text-[var(--color-muted)]">
				Every governance contract, badge and treasury account the DAO uses is listed below with a
				link to the Radix Dashboard.
			</p>
		</PageHeader>
	</Band>

	<Band tone="paper" ruled compact>
		<h2 class="label">The register</h2>
		<p class="mt-3 max-w-[64ch] text-[0.875rem] text-[var(--color-muted)]">
			Treasury accounts are shown even though they are not yet deployed, marked pending — so this
			table always reflects the DAO's real state rather than hiding what doesn't exist yet.
		</p>
		<div class="table-scroll mt-6">
			<table class="w-full min-w-[38rem] border-collapse text-left">
				<thead>
					<tr>
						<th class="label w-[13rem] border-b border-[var(--color-rule)] pr-5 pb-2.5 font-medium">
							Function
						</th>
						<th class="label border-b border-[var(--color-rule)] pr-5 pb-2.5 font-medium">
							On-chain identifier
						</th>
						<th class="label w-[7rem] border-b border-[var(--color-rule)] pr-5 pb-2.5 font-medium">
							Status
						</th>
						<th class="label w-[6rem] border-b border-[var(--color-rule)] pb-2.5 font-medium">
							Verify
						</th>
					</tr>
				</thead>
				<tbody>
					{
						identifiers.governance.map((row: GovernanceRow) => (
							<tr>
								<td class="border-b border-[var(--color-rule)] py-4 pr-5 align-middle text-[0.90625rem] font-semibold">
									{row.function}
								</td>
								<td class="data border-b border-[var(--color-rule)] py-4 pr-5 align-middle text-[0.75rem] break-all text-[var(--color-muted)]">
									{row.identifier}
								</td>
								<td class="border-b border-[var(--color-rule)] py-4 pr-5 align-middle">
									<span class="data text-[0.75rem] whitespace-nowrap text-[var(--color-muted)]">
										<span
											class="mr-1.5 inline-block size-[7px] rounded-full bg-[var(--color-live)] align-[1px]"
											aria-hidden="true"
										/>
										Live
									</span>
								</td>
								<td class="border-b border-[var(--color-rule)] py-4 align-middle">
									<a href={row.verifyHref} class="onward text-[0.8125rem] whitespace-nowrap">
										Check <span aria-hidden="true">&rsaquo;</span>
									</a>
								</td>
							</tr>
						))
					}
					{
						identifiers.treasury.map((row: TreasuryRow) => (
							<tr class="opacity-70">
								<td class="border-b border-[var(--color-rule)] py-4 pr-5 align-middle text-[0.90625rem] font-semibold">
									{row.function}
									{row.note && (
										<span class="mt-0.5 block text-[0.78125rem] font-normal text-[var(--color-muted)]">
											{row.note}
										</span>
									)}
								</td>
								<td class="data border-b border-[var(--color-rule)] py-4 pr-5 align-middle text-[0.75rem] text-[var(--color-muted)]">
									not yet deployed
								</td>
								<td class="border-b border-[var(--color-rule)] py-4 pr-5 align-middle">
									<span class="data text-[0.75rem] whitespace-nowrap text-[var(--color-muted)]">
										<span
											class="mr-1.5 inline-block size-[7px] rounded-full bg-[var(--color-pending)] align-[1px]"
											aria-hidden="true"
										/>
										Pending
									</span>
								</td>
								<td class="border-b border-[var(--color-rule)] py-4 align-middle text-[0.8125rem] text-[var(--color-muted)]">
									&mdash;
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<p class="mt-5 max-w-[64ch] text-[0.875rem] text-[var(--color-muted)]">
			{identifiers.lsuNote}
			<a href={identifiers.lsuMethodHref} class="onward">
				Read the snapshot method <span aria-hidden="true">&rsaquo;</span>
			</a>
		</p>
		<a href={identifiers.sourceHref} class="onward mt-3 inline-block text-[0.875rem]">
			Source policy <span aria-hidden="true">&rsaquo;</span>
		</a>
	</Band>

	<Band ruled compact>
		<h2 class="label" id="documents">Documents</h2>
		<p class="mt-3 max-w-[64ch] text-[0.875rem] text-[var(--color-muted)]">
			{
				inForce.length === 0 ? (
					<>
						When a governance document is activated it is published as a PDF, and the SHA-256
						digest of that exact file is recorded on-chain by the proposal that activated it.
						Anyone can then check a copy against that digest &mdash; a match proves the file is
						byte-for-byte the document that was voted on, no matter where the copy came from.
						No document has been activated yet, so there is nothing to check against so far.
					</>
				) : (
					<>
						Each activated document below is published as a PDF whose SHA-256 digest is recorded
						on-chain by the proposal that activated it. A match proves the file is byte-for-byte
						the document that was voted on, no matter where the copy came from.
					</>
				)
			}
		</p>

		<DocumentRegister />

		<DocumentVerifier />

		<p class="mt-5 max-w-[64ch] text-[0.875rem] text-[var(--color-muted)]">
			You do not have to trust this page. The same check from a terminal:
		</p>
		<pre
			class="data mt-3 overflow-x-auto border-l-2 border-[var(--color-rule)] bg-[var(--color-paper)] py-3 pr-4 pl-4 text-[0.75rem] leading-relaxed">Windows    Get-FileHash -Algorithm SHA256 document.pdf
macOS      shasum -a 256 document.pdf
Linux      sha256sum document.pdf</pre>

		<a href="/govern/" class="onward mt-5 inline-block text-[0.875rem]">
			Every governance document <span aria-hidden="true">&rsaquo;</span>
		</a>
	</Band>
</BaseLayout>
