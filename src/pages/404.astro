---
import Band from '../components/Band.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
	<Band>
		<span class="label text-[var(--color-accent)]">404</span>
		<h1 class="mt-4 max-w-[16ch] text-[2.25rem] md:text-[2.875rem]">Page not found</h1>
		<p class="mt-5 max-w-[52ch] text-[1.0625rem] text-[var(--color-muted)]">
			There is nothing at this address. Nothing has been removed from the record — items here are
			permanent — so this is most likely a mistyped or outdated link.
		</p>
		<div class="mt-7 flex flex-wrap gap-x-7 gap-y-2">
			<a href="/notices/" class="onward">
				Notices &amp; Records <span aria-hidden="true">&rsaquo;</span>
			</a>
			<a href="/" class="onward">
				Home <span aria-hidden="true">&rsaquo;</span>
			</a>
		</div>
	</Band>
</BaseLayout>
