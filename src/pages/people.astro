---
import Band from '../components/Band.astro'
import PageHeader from '../components/PageHeader.astro'
import SeatTable from '../components/SeatTable.astro'
import type { Seat } from '../components/SeatTable.astro'
import roles from '../data/roles.json'
import BaseLayout from '../layouts/BaseLayout.astro'

// §6.5: this page must render honestly, which now means showing two bodies at
// once. Both are elected; they differ in mandate. The Transition Council was
// elected to stand the DAO up and is seated; the Permanent Council is the
// standing body under the ratified framework and is empty. They stay in
// separate tables so the two mandates are not read as one, and the empty seats
// stay visible rather than being hidden until they are filled.
const transition = roles.transitionCouncil
const council = roles.council

const transitionSeats: Seat[] = transition.seats ?? []
const councilSeats: Seat[] = council.seats ?? []
---

<BaseLayout title="People" description="Who is accountable for Radix DAO, and how to reach them.">
	<Band compact>
		<PageHeader question="Who is accountable, and how do I reach them?" heading="Who's accountable">
			<p class="mt-5 max-w-[54ch] text-[1.0625rem] text-[var(--color-muted)]">{roles.asOf}</p>
		</PageHeader>
	</Band>

	<Band tone="paper" ruled compact>
		<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
			<h2 class="text-[1.375rem]">{transition.name}</h2>
			<p class="data text-[0.8125rem] text-[var(--color-muted)]">
				{transition.filled} of {transition.seatCount} seats filled · elected, transitional mandate
			</p>
		</div>
		<p class="mt-3 max-w-[62ch] text-[0.9375rem] text-[var(--color-muted)]">{transition.note}</p>
		<p class="mt-2.5 max-w-[62ch] text-[0.9375rem] text-[var(--color-muted)]">
			{transition.standingNote}
		</p>

		<SeatTable
			seats={transitionSeats}
			rowCount={transition.seatCount}
			termFallback={transition.termNote}
			vacantLabel="Vacant"
		/>
	</Band>

	<Band compact>
		<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
			<h2 class="text-[1.375rem]">{council.name}</h2>
			<p class="data text-[0.8125rem] text-[var(--color-muted)]">
				{council.filled} of {council.seatMin}&ndash;{council.seatMax} seats filled · {
					council.termMonths
				}-month terms
			</p>
		</div>
		<p class="mt-3 max-w-[62ch] text-[0.9375rem] text-[var(--color-muted)]">
			The standing body under the ratified framework, elected to six-month terms once the transition
			is complete. Every seat below is open; the Transition Council's seats end on the day these are
			filled.
		</p>

		<SeatTable seats={councilSeats} rowCount={council.seatMax} requiredCount={council.seatMin} />

		<a href="/participate/" class="onward mt-6 inline-block text-[0.875rem]">
			How seats get filled <span aria-hidden="true">&rsaquo;</span>
		</a>
	</Band>

	<Band tone="paper" ruled compact>
		<h2 class="text-[1.375rem]">Delegated Functions</h2>
		<p class="mt-3 max-w-[60ch] text-[0.9375rem] text-[var(--color-muted)]">
			Allocated by the Permanent Council from among its own seated members, not separately elected.
			Each one ends when that member's seat ends, so they are shown attached to a person rather than
			as standalone offices. The Transition Council holds none of them.
		</p>
		<ul class="mt-6 border-t border-[var(--color-rule)]">
			{
				roles.delegatedFunctions.map((fn: { name: string; note: string }) => (
					<li class="grid items-baseline gap-x-8 gap-y-1 border-b border-[var(--color-rule)] py-4 md:grid-cols-[16rem_1fr]">
						<span class="text-[0.9375rem] font-semibold">{fn.name}</span>
						<span class="text-[0.875rem] text-[var(--color-muted)]">
							{fn.note || 'Not yet allocated — allocated by the Permanent Council once elected.'}
						</span>
					</li>
				))
			}
		</ul>
	</Band>

	<Band compact>
		<h2 class="text-[1.375rem]">Working Group Stewards</h2>
		<ul class="mt-6 border-t border-[var(--color-rule)]">
			{
				roles.workingGroups.map((wg: { name: string; status: string }) => (
					<li class="grid items-baseline gap-x-8 gap-y-1 border-b border-[var(--color-rule)] py-4 md:grid-cols-[22rem_1fr]">
						<span class="text-[0.9375rem] font-semibold">{wg.name}</span>
						<span class="text-[0.875rem] text-[var(--color-muted)]">{wg.status}</span>
					</li>
				))
			}
		</ul>
	</Band>
</BaseLayout>
